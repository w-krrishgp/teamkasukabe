# ==========================================
# HarvestGuard - Environment Configuration
# ==========================================
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control.

# Application Environment
VITE_APP_NAME="HarvestGuard"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0"

# Supabase Backend Integration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Agricultural & Meteorological Services (Optional)
# Open-Meteo is free & no-key, but if using OpenWeatherMap:
VITE_WEATHER_API_KEY="your-weather-api-key"

# Mandi / Market Prices API (e.g. Data.gov.in Agmarknet API)
VITE_AGRI_MARKET_API_KEY="your-agri-market-api-key"

# Farm Intelligence / AI Advisory
VITE_GEMINI_API_KEY="your-gemini-ai-key"

# Feature Flags
VITE_ENABLE_MOCK_FALLBACK="true"
VITE_ENABLE_OFFLINE_CACHE="true"

# Firebase Cloud Messaging (FCM) & Push Notifications
# Obtain these from Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""
